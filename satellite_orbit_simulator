    function formatNumber(value, digits = 2, fallback = '-') {
      return Number.isFinite(value) ? Number(value).toFixed(digits) : fallback;
    }

    function withTemporaryParams(nextParams, callback) {
      const backup = { ...params };
      Object.assign(params, nextParams);
      try {
        return callback();
      } finally {
        Object.assign(params, backup);
      }
    }

    function simulateRepresentativePass(condition) {
      const scanStep = 10;
      return withTemporaryParams(condition.params, () => {
        const period = orbitalPeriod();
        const scanEnd = Math.max(period * 3, 18000);
        const passes = [];
        let current = null;

        for (let t = 0; t <= scanEnd; t += scanStep) {
          const sat = satelliteStateAt(t);
          const obs = observerState(t);
          const topo = topocentric(sat.positionKm, obs);
          const signal = signalStrength(topo.elevation, topo.range);
          const visible = topo.elevation > 0;

          if (visible && !current) {
            current = {
              start_s: t,
              end_s: t,
              samples: []
            };
          }

          if (visible && current) {
            current.end_s = t;
            current.samples.push({
              time_s: Number(t.toFixed(2)),
              signal,
              elevation_deg: topo.elevation / DEG,
              range_km: topo.range
            });
          }

          if ((!visible || t >= scanEnd) && current) {
            if (current.samples.length >= 2) {
              passes.push(current);
            }
            current = null;
          }
        }

        if (!passes.length) {
          return {
            condition: condition.key,
            meaning: condition.meaning,
            search_type: condition.search_type || 'fixed',
            semi_major_km: condition.params.semiMajor,
            inclination_deg: condition.params.inclination,
            duration_s: 0,
            max_elevation_deg: null,
            min_range_km: null,
            max_signal: 0,
            q: 0,
            avg_signal: 0,
            pass_start_s: 0,
            pass_end_s: 0,
            replay_start_s: 0,
            replay_end_s: 600,
            params_snapshot: { ...condition.params },
            note: '관측 이벤트 없음'
          };
        }

        const summarized = passes.map(pass => {
          const rows = pass.samples;
          const q = trapezoidAreaFromRows(rows);
          const duration = Math.max(0, pass.end_s - pass.start_s);
          const maxSignal = Math.max(...rows.map(row => row.signal));
          const maxElevation = Math.max(...rows.map(row => row.elevation_deg));
          const minRange = Math.min(...rows.map(row => row.range_km));
          const avgSignal = duration > 0 ? q / duration : 0;
          return {
            condition: condition.key,
            meaning: condition.meaning,
            search_type: condition.search_type || 'fixed',
            semi_major_km: condition.params.semiMajor,
            inclination_deg: condition.params.inclination,
            duration_s: Number(duration.toFixed(2)),
            max_elevation_deg: Number(maxElevation.toFixed(3)),
            min_range_km: Number(minRange.toFixed(3)),
            max_signal: Number(maxSignal.toFixed(6)),
            q: Number(q.toFixed(6)),
            avg_signal: Number(avgSignal.toFixed(6)),
            pass_start_s: Number(pass.start_s.toFixed(2)),
            pass_end_s: Number(pass.end_s.toFixed(2)),
            replay_start_s: Number(Math.max(0, pass.start_s - 90).toFixed(2)),
            replay_end_s: Number((pass.end_s + 90).toFixed(2)),
            params_snapshot: { ...condition.params },
            note: '대표 통과'
          };
        });

        summarized.sort((a, b) => b.q - a.q);
        return summarized[0];
      });
    }

    function getAutoExperimentConditions() {
      const base = {
        eccentricity: 0.001,
        raan: 40,
        argPerigee: 0,
        meanAnomaly: 285,
        observerLat: 37.5,
        observerLon: 127.0,
        signalGain: 2.0,
        carrierFreq: 137,
        bandwidth: 120,
        timeScale: params.timeScale,
        cameraSpeed: params.cameraSpeed,
        manualTime: 0
      };

      const semiMajorValues = [6800, 7000, 7200, 7600, 8000, 8500, 9000];
      const inclinationValues = [0, 20, 37.5, 55, 75, 98, 110];
      const conditions = [];

      semiMajorValues.forEach(a => {
        inclinationValues.forEach(i => {
          conditions.push({
            key: `탐색 ${conditions.length + 1}`,
            meaning: `a=${a} km, i=${i}°`,
            params: { ...base, semiMajor: a, inclination: i },
            search_type: 'grid'
          });
        });
      });

      [
        { key: '기준-적도', meaning: '적도 궤도 기준', params: { ...base, semiMajor: 7200, inclination: 0 }, search_type: 'reference' },
        { key: '기준-한국위도', meaning: '대한민국 위도형 기준', params: { ...base, semiMajor: 7200, inclination: 37.5 }, search_type: 'reference' },
        { key: '기준-NOAA형', meaning: 'NOAA형 극궤도 기준', params: { ...base, semiMajor: 7200, inclination: 98 }, search_type: 'reference' }
      ].forEach(condition => conditions.push(condition));

      return conditions;
    }

    function runAutoExperiment() {
      const button = document.getElementById('runAutoExperiment');
      if (button) {
        button.disabled = true;
        button.textContent = '탐색 중...';
      }

      setTimeout(() => {
        try {
          const allResults = getAutoExperimentConditions().map(condition => simulateRepresentativePass(condition));
          autoExperimentResults = rankAutoExperimentResults(allResults);
          renderAutoExperimentResults();
        } finally {
          if (button) {
            button.disabled = false;
            button.textContent = '자동 탐색 실행';
          }
        }
      }, 30);
    }

    function rankAutoExperimentResults(rows) {
      const valid = rows.filter(row => row.q > 0).sort((a, b) => b.q - a.q);
      const invalid = rows.filter(row => row.q <= 0);
      const topGrid = valid.filter(row => row.search_type !== 'reference').slice(0, 10);
      const references = valid.filter(row => row.search_type === 'reference');
      const missingReferences = rows.filter(row => row.search_type === 'reference' && row.q <= 0);
      return [...topGrid, ...references, ...missingReferences, ...invalid.slice(0, 3)];
    }

    function renderAutoExperimentResults() {
      const tbody = document.getElementById('autoExperimentTableBody');
      if (!tbody) return;
      if (!autoExperimentResults.length) {
        tbody.innerHTML = '<tr><td colspan="11" style="text-align:left;">아직 자동 탐색을 실행하지 않았습니다.</td></tr>';
        return;
      }

      tbody.innerHTML = autoExperimentResults.map((row, idx) => `
        <tr>
          <td>${row.search_type === 'reference' ? row.condition : `${idx + 1}위`}</td>
          <td>${row.meaning}</td>
          <td>${formatNumber(row.semi_major_km, 0)}</td>
          <td>${formatNumber(row.inclination_deg, 1)}</td>
          <td>${formatNumber(row.duration_s, 0)}</td>
          <td>${formatNumber(row.max_elevation_deg, 1)}</td>
          <td>${formatNumber(row.min_range_km, 0)}</td>
          <td>${formatNumber(row.max_signal, 4)}</td>
          <td>${formatNumber(row.q, 2)}</td>
          <td>${formatNumber(row.avg_signal, 4)}</td>
          <td><button class="auto-view-btn" data-auto-result="${idx}">보기</button></td>
        </tr>
      `).join('');

      tbody.querySelectorAll('[data-auto-result]').forEach(button => {
        button.addEventListener('click', () => startSimulationFromAutoResult(Number(button.dataset.autoResult)));
      });

      const summaryEl = document.getElementById('autoExperimentSummary');
      if (summaryEl) summaryEl.textContent = buildAutoExperimentSummary(autoExperimentResults);
    }

    function buildAutoExperimentSummary(rows) {
      if (!rows.length) return '자동 탐색 결과가 없습니다.';
      const valid = rows.filter(row => row.q > 0);
      if (!valid.length) return '모든 조건에서 관측 이벤트가 감지되지 않았습니다. 초기 평균근점이각 M₀ 또는 승교점 Ω을 조정해야 합니다.';

      const ranked = [...valid].sort((a, b) => b.q - a.q);
      const bestQ = ranked[0];
      const bestPeak = [...valid].sort((a, b) => b.max_signal - a.max_signal)[0];
      const bestDuration = [...valid].sort((a, b) => b.duration_s - a.duration_s)[0];

      const topThree = ranked.slice(0, 3)
        .map((row, idx) => `${idx + 1}위: a=${row.semi_major_km.toFixed(0)} km, i=${row.inclination_deg.toFixed(1)}°, Q≈${row.q.toFixed(2)}`)
        .join('\n');

      const referenceRows = valid.filter(row => row.search_type === 'reference');
      const referenceText = referenceRows.length
        ? referenceRows.map(row => `${row.condition}: Q≈${row.q.toFixed(2)}, 최대고도≈${row.max_elevation_deg.toFixed(1)}°`).join('\n')
        : '기준 조건에서 관측 이벤트가 감지되지 않았습니다.';

      const lines = [];
      lines.push(`자동 탐색은 장반경 a 7개 값과 경사각 i 7개 값을 조합한 격자 조건을 실제로 계산한 뒤, 누적 수신량 Q가 큰 조건을 정렬한 것입니다.`);
      lines.push(`탐색 결과 상위 조건:\n${topThree}`);
