    function createEarthTexture() {
      const canvas = document.createElement('canvas');
      canvas.width = 2048;
      canvas.height = 1024;
      const ctx = canvas.getContext('2d');

      const ocean = ctx.createLinearGradient(0, 0, 0, canvas.height);
      ocean.addColorStop(0, '#0a315f');
      ocean.addColorStop(0.5, '#0d4f90');
      ocean.addColorStop(1, '#06264f');
      ctx.fillStyle = ocean;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      for (let y = 0; y < canvas.height; y++) {
        const lat = 90 - 180 * y / canvas.height;
        const polar = Math.pow(Math.abs(lat) / 90, 2.4);
        ctx.fillStyle = `rgba(220,240,255,${0.13 * polar})`;
        ctx.fillRect(0, y, canvas.width, 1);
      }

      const continents = [
        { lon: -100, lat: 45, sx: 210, sy: 135, color: '#3e7b4a' },
        { lon: -60, lat: -15, sx: 130, sy: 210, color: '#3f7a44' },
        { lon: 20, lat: 5, sx: 185, sy: 235, color: '#6f7d42' },
        { lon: 75, lat: 48, sx: 310, sy: 145, color: '#4f8249' },
        { lon: 105, lat: 20, sx: 175, sy: 150, color: '#547f43' },
        { lon: 135, lat: -25, sx: 115, sy: 78, color: '#8a7848' },
        { lon: -42, lat: 72, sx: 95, sy: 55, color: '#dce8e8' },
        { lon: 0, lat: -82, sx: 900, sy: 42, color: '#eef6f8' }
      ];

      continents.forEach((c, idx) => drawContinentBlob(ctx, canvas, c, idx));

      for (let i = 0; i < 900; i++) {
        const x = pseudoRandom(i * 13.1) * canvas.width;
        const y = pseudoRandom(i * 31.7 + 9) * canvas.height;
        const latFactor = Math.cos((y / canvas.height - 0.5) * Math.PI);
        const r = 8 + pseudoRandom(i * 7.7) * 38 * latFactor;
        ctx.fillStyle = `rgba(255,255,255,${0.018 + pseudoRandom(i * 5.3) * 0.035})`;
        ctx.beginPath();
        ctx.ellipse(x, y, r * 2.2, r * 0.45, pseudoRandom(i) * Math.PI, 0, Math.PI * 2);
        ctx.fill();
      }

      const texture = new THREE.CanvasTexture(canvas);
      texture.colorSpace = THREE.SRGBColorSpace;
      texture.wrapS = THREE.RepeatWrapping;
      texture.wrapT = THREE.ClampToEdgeWrapping;
      texture.anisotropy = 8;
      return texture;
    }

    function createEarthBumpTexture() {
      const canvas = document.createElement('canvas');
      canvas.width = 1024;
      canvas.height = 512;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#202020';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      for (let i = 0; i < 1800; i++) {
        const x = pseudoRandom(i * 19.1) * canvas.width;
        const y = pseudoRandom(i * 23.7) * canvas.height;
        const r = 1 + pseudoRandom(i * 2.7) * 6;
        const v = Math.floor(55 + pseudoRandom(i * 11.5) * 115);
        ctx.fillStyle = `rgb(${v},${v},${v})`;
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fill();
      }
      const texture = new THREE.CanvasTexture(canvas);
      texture.wrapS = THREE.RepeatWrapping;
      texture.wrapT = THREE.ClampToEdgeWrapping;
      return texture;
    }

    function drawContinentBlob(ctx, canvas, c, seed) {
      const cx = ((c.lon + 180) / 360) * canvas.width;
      const cy = ((90 - c.lat) / 180) * canvas.height;
      const points = 34;

      ctx.beginPath();
      for (let i = 0; i <= points; i++) {
        const a = Math.PI * 2 * i / points;
        const rough = 0.62 + pseudoRandom(seed * 100 + i * 4.37) * 0.72;
        const x = cx + Math.cos(a) * c.sx * rough;
        const y = cy + Math.sin(a) * c.sy * rough;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.closePath();
      ctx.fillStyle = c.color;
      ctx.fill();

      ctx.fillStyle = 'rgba(230,210,150,0.18)';
      for (let i = 0; i < 28; i++) {
        const x = cx + (pseudoRandom(seed * 51 + i) - 0.5) * c.sx * 1.4;
        const y = cy + (pseudoRandom(seed * 87 + i) - 0.5) * c.sy * 1.2;
        ctx.beginPath();
        ctx.ellipse(x, y, 6 + pseudoRandom(i) * 18, 2 + pseudoRandom(i + 4) * 8, pseudoRandom(i + seed) * Math.PI, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function pseudoRandom(x) {
      const s = Math.sin(x * 12.9898) * 43758.5453123;
      return s - Math.floor(s);
    }

    function makeCirclePoints(radius, count, y) {
      const pts = [];
      for (let i = 0; i <= count; i++) {
        const a = TWO_PI * i / count;
        pts.push(new THREE.Vector3(radius * Math.cos(a), y, radius * Math.sin(a)));
      }
      return pts;
    }

    function makeDirectionLine(color, end) {
