    function addLatitudeLongitudeLines() {
      for (let lat = -60; lat <= 60; lat += 30) {
        const pts = [];
        const latRad = lat * DEG;
        for (let lon = 0; lon <= 360; lon += 4) pts.push(geoToVector(latRad, lon * DEG, EARTH_RADIUS_KM + 10).multiplyScalar(KM_TO_SCENE));
        earthGroup.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), gridMaterial));
      }
      for (let lon = 0; lon < 360; lon += 30) {
        const pts = [];
        const lonRad = lon * DEG;
        for (let lat = -90; lat <= 90; lat += 4) pts.push(geoToVector(lat * DEG, lonRad, EARTH_RADIUS_KM + 10).multiplyScalar(KM_TO_SCENE));
        earthGroup.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), gridMaterial));
      }
    }

    function geoToVector(latRad, lonRad, radiusKm) {
      const cosLat = Math.cos(latRad);
      return new THREE.Vector3(radiusKm * cosLat * Math.cos(lonRad), radiusKm * Math.sin(latRad), radiusKm * cosLat * Math.sin(lonRad));
    }

    function bindControls() {
      const ids = Object.keys(params).filter(id => document.getElementById(id));
      const elements = {};
      ids.forEach(id => {
        const input = document.getElementById(id);
        const number = document.getElementById(`${id}Number`);
        const value = document.getElementById(`${id}Value`);
        elements[id] = { input, number, value };

        const applyParamValue = rawValue => {
          const min = Number(input.min);
          const max = Number(input.max);
          let nextValue = Number(rawValue);
          if (!Number.isFinite(nextValue)) nextValue = params[id];
          nextValue = Math.max(min, Math.min(max, nextValue));
          params[id] = nextValue;
          input.value = nextValue;
          if (number) number.value = nextValue;

          if (id === 'manualTime') {
            simTime = params.manualTime;
            resetIntegration(false);
          }
          if (['semiMajor','eccentricity','inclination','raan','argPerigee','meanAnomaly','observerLat','observerLon','signalGain','carrierFreq','bandwidth'].includes(id)) {
            resetIntegration(true);
            if (['semiMajor','eccentricity','inclination','raan','argPerigee','meanAnomaly'].includes(id)) { orbitSignature = ''; resetIntegration(true); }
          }
          updateLabels(elements);
          rebuildOrbitVisuals();
        };

        input.addEventListener('input', () => applyParamValue(input.value));
        if (number) {
          number.addEventListener('change', () => applyParamValue(number.value));
          number.addEventListener('keydown', event => {
            if (event.key === 'Enter') {
              applyParamValue(number.value);
              number.blur();
            }
          });
        }
      });
      updateLabels(elements);
      return elements;
    }

