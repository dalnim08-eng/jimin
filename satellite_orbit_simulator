  <script type="module">
    import * as THREE from 'https://esm.sh/three@0.160.0';
    import { OrbitControls } from 'https://esm.sh/three@0.160.0/examples/jsm/controls/OrbitControls.js';

    const KM_TO_SCENE = 1 / 1800;
    const EARTH_RADIUS_KM = 6371;
    const MU = 398600.4418;
    const C_KM_S = 299792.458;
    const EARTH_ROT_RATE = 7.2921159e-5;
    const DEG = Math.PI / 180;
    const TWO_PI = Math.PI * 2;

    const params = {
      semiMajor: 7200,
      eccentricity: 0.02,
      inclination: 98,
      raan: 35,
      argPerigee: 40,
      meanAnomaly: 285,
      observerLat: 37.5,
      observerLon: 127.0,
      signalGain: 2.0,
      carrierFreq: 137,
      bandwidth: 120,
      timeScale: 45,
      cameraSpeed: 1.0,
      manualTime: 0
    };

    let simTime = 0;
    let running = true;
    let lastFrame = performance.now();
    let lastSignal = 0;
    let lastSignalTime = 0;
    let signalIntegral = 0;
    let graphSamples = [];
    let analysisSamples = [];
    let passSummaries = [];
    let activePass = null;
    let autoExperimentResults = [];
    let replayMode = null;
    let lastAnalysisSampleTime = -Infinity;
    const PRESET_STORAGE_KEY = 'satellite_orbit_simulator_experiment_presets_v1';
    let cumulativeSpectrum = new Float32Array(512);
    let orbitSignature = '';

    const canvas = document.getElementById('scene');
    const scene = new THREE.Scene();
    scene.fog = null;

    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.01, 1800);
    camera.position.set(0, 5.2, 8.2);

    const observerCanvas = document.getElementById('observerView');
    const observerScene = new THREE.Scene();
    const observerCamera = new THREE.PerspectiveCamera(50, observerCanvas.width / observerCanvas.height, 0.01, 100);
    observerCamera.position.set(0, 2.0, 5.2);
    observerCamera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);

    const observerRenderer = new THREE.WebGLRenderer({ canvas: observerCanvas, antialias: true, alpha: true });
    observerRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    observerRenderer.setSize(observerCanvas.clientWidth, observerCanvas.clientHeight, false);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.06;
    controls.minDistance = 4;
    controls.maxDistance = 820;

    const pressedKeys = new Set();
    window.addEventListener('keydown', event => {
      if (event.target.closest?.('input, textarea, select, button')) return;
      const key = event.key.toLowerCase();
      if (['w', 'a', 's', 'd'].includes(key)) {
        pressedKeys.add(key);
        event.preventDefault();
      }
    });
    window.addEventListener('keyup', event => {
      const key = event.key.toLowerCase();
      if (['w', 'a', 's', 'd'].includes(key)) {
        pressedKeys.delete(key);
        event.preventDefault();
      }
    });
    window.addEventListener('blur', () => pressedKeys.clear());

    const observerControls = new OrbitControls(observerCamera, observerRenderer.domElement);
    observerControls.enableDamping = true;
    observerControls.dampingFactor = 0.06;
    observerControls.minDistance = 2.4;
    observerControls.maxDistance = 9;
    observerControls.target.set(0, 0, 0);

    scene.add(new THREE.AmbientLight(0x88aaff, 1.05));
    const sun = new THREE.DirectionalLight(0xffffff, 2.6);
    sun.position.set(5, 4, 8);
    scene.add(sun);

    observerScene.add(new THREE.AmbientLight(0x88aaff, 1.4));
    const observerLight = new THREE.DirectionalLight(0xffffff, 1.8);
    observerLight.position.set(3, 5, 4);
    observerScene.add(observerLight);

    const earthRadius = EARTH_RADIUS_KM * KM_TO_SCENE;
    const earthGroup = new THREE.Group();
    scene.add(earthGroup);

    const earthTexture = createEarthTexture();
    const earthBumpTexture = createEarthBumpTexture();
    const earth = new THREE.Mesh(
      new THREE.SphereGeometry(earthRadius, 128, 96),
      new THREE.MeshPhongMaterial({
        map: earthTexture,
        bumpMap: earthBumpTexture,
        bumpScale: 0.035,
        shininess: 18,
        emissive: 0x020914,
        specular: 0x6aa8d8
      })
    );
    earthGroup.add(earth);

    const atmosphere = new THREE.Mesh(
      new THREE.SphereGeometry(earthRadius * 1.018, 128, 96),
      new THREE.MeshBasicMaterial({ color: 0x73c7ff, transparent: true, opacity: 0.045, depthWrite: false })
    );
    earthGroup.add(atmosphere);

    const gridMaterial = new THREE.LineBasicMaterial({ color: 0x7fb8ff, transparent: true, opacity: 0.20 });
    addLatitudeLongitudeLines();

    const orbitLine = new THREE.Line(new THREE.BufferGeometry(), new THREE.LineBasicMaterial({ color: 0x75d6ff, transparent: true, opacity: 0.75 }));
    scene.add(orbitLine);

    const groundTrackLine = new THREE.Line(new THREE.BufferGeometry(), new THREE.LineBasicMaterial({ color: 0xffcf70, transparent: true, opacity: 0.62 }));
    scene.add(groundTrackLine);

    const satellite = new THREE.Mesh(new THREE.SphereGeometry(0.075, 32, 24), new THREE.MeshBasicMaterial({ color: 0xffffff }));
    scene.add(satellite);

    const observer = new THREE.Mesh(
      new THREE.SphereGeometry(0.055, 32, 24),
      new THREE.MeshStandardMaterial({ color: 0x9cffb0, emissive: 0x1cff77, emissiveIntensity: 0.8 })
    );
    scene.add(observer);

