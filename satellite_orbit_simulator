    function recordAnalysisSample(t, sat, topo, signal, signalRate, rangeRate, dopplerHz, fObserved) {
      if (!running) return;
      if (t - lastAnalysisSampleTime < 1) return;
      lastAnalysisSampleTime = t;

      const visible = topo.elevation > 0;
      const row = {
        time_s: Number(t.toFixed(2)),
        signal: Number(signal.toFixed(6)),
        signal_rate_per_s: Number(signalRate.toFixed(7)),
        cumulative_q: Number(signalIntegral.toFixed(6)),
        elevation_deg: Number((topo.elevation / DEG).toFixed(4)),
        azimuth_deg: Number((topo.azimuth / DEG).toFixed(4)),
        range_km: Number(topo.range.toFixed(3)),
        range_rate_km_s: Number(rangeRate.toFixed(6)),
        doppler_hz: Number(dopplerHz.toFixed(3)),
        observed_freq_mhz: Number(fObserved.toFixed(9)),
        altitude_km: Number((sat.radiusKm - EARTH_RADIUS_KM).toFixed(3)),
        visible: visible ? 1 : 0
      };
      analysisSamples.push(row);
      if (analysisSamples.length > 20000) analysisSamples.shift();

      if (visible && !activePass) {
        activePass = {
          start_s: t,
          end_s: t,
          duration_s: 0,
          q_start: signalIntegral,
          q_end: signalIntegral,
          q_added: 0,
          max_signal: signal,
          max_signal_time_s: t,
          max_elevation_deg: topo.elevation / DEG,
          min_range_km: topo.range,
          sample_count: 1
        };
      } else if (visible && activePass) {
        activePass.end_s = t;
        activePass.duration_s = activePass.end_s - activePass.start_s;
        activePass.q_end = signalIntegral;
        activePass.q_added = activePass.q_end - activePass.q_start;
        activePass.sample_count += 1;
        if (signal > activePass.max_signal) {
          activePass.max_signal = signal;
          activePass.max_signal_time_s = t;
        }
        activePass.max_elevation_deg = Math.max(activePass.max_elevation_deg, topo.elevation / DEG);
        activePass.min_range_km = Math.min(activePass.min_range_km, topo.range);
      } else if (!visible && activePass) {
        if (activePass.duration_s > 0) {
          passSummaries.push(roundPassSummary(activePass));
        }
        activePass = null;
      }

      updateAnalysisPanel();
    }

    function roundPassSummary(pass) {
      return {
        start_s: Number(pass.start_s.toFixed(2)),
        end_s: Number(pass.end_s.toFixed(2)),
        duration_s: Number(pass.duration_s.toFixed(2)),
        q_added: Number(pass.q_added.toFixed(6)),
        max_signal: Number(pass.max_signal.toFixed(6)),
        max_signal_time_s: Number(pass.max_signal_time_s.toFixed(2)),
        max_elevation_deg: Number(pass.max_elevation_deg.toFixed(3)),
        min_range_km: Number(pass.min_range_km.toFixed(3)),
        sample_count: pass.sample_count
      };
    }

    function getCurrentAnalysisSummary() {
      const visibleRows = analysisSamples.filter(row => row.visible === 1);
      const maxSignal = analysisSamples.reduce((m, row) => Math.max(m, row.signal), 0);
      const maxElevation = analysisSamples.length ? Math.max(...analysisSamples.map(row => row.elevation_deg)) : null;
      const minRange = analysisSamples.length ? Math.min(...analysisSamples.map(row => row.range_km)) : null;
      const visibleTime = visibleRows.length;
      const passes = activePass ? [...passSummaries, roundPassSummary(activePass)] : [...passSummaries];
      const graphStats = graphWindowIntegralStats(orbitalPeriod());
      return {
        sample_count: analysisSamples.length,
        visible_time_s_approx: visibleTime,
        max_signal: maxSignal,
        max_elevation_deg: maxElevation,
        min_range_km: minRange,
        total_q: signalIntegral,
        window_q: graphStats.area,
        avg_signal: graphStats.avgSignal,
        integral_fill_ratio: graphStats.fillRatio,
        pass_count: passes.length,
        passes
      };
    }

    function updateAnalysisPanel() {
      const summary = getCurrentAnalysisSummary();
      document.getElementById('analysisSamples').textContent = `${summary.sample_count}`;
      document.getElementById('analysisVisibleTime').textContent = `${summary.visible_time_s_approx.toFixed(0)} s`;
      document.getElementById('analysisMaxSignal').textContent = summary.max_signal.toFixed(4);
