    function importPresetsFromFile(event) {
      const file = event.target.files?.[0];
      event.target.value = '';
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const parsed = JSON.parse(String(reader.result || '{}'));
          const incoming = Array.isArray(parsed) ? parsed : parsed.presets;
          if (!Array.isArray(incoming)) throw new Error('invalid preset file');
          const valid = incoming
            .filter(item => item && typeof item === 'object' && item.parameters && typeof item.parameters === 'object')
            .map((item, index) => ({
              name: String(item.name || `가져온 실험 조건 ${index + 1}`),
              saved_at: item.saved_at || new Date().toISOString(),
              parameters: item.parameters
            }));
          if (!valid.length) throw new Error('no valid presets');
          const merged = [...readPresets()];
          valid.forEach(preset => {
            const existingIndex = merged.findIndex(item => item.name === preset.name);
            if (existingIndex >= 0) merged[existingIndex] = preset;
            else merged.push(preset);
          });
          writePresets(merged);
          window.alert(`${valid.length}개의 실험 조건을 가져왔습니다.`);
        } catch (error) {
          window.alert('설정 파일을 읽지 못했습니다. 이 시뮬레이터에서 내보낸 JSON 파일인지 확인해 주세요.');
        }
      };
      reader.readAsText(file, 'utf-8');
    }

    function orbitalPeriod() { return TWO_PI * Math.sqrt(Math.pow(params.semiMajor, 3) / MU); }
    function meanMotion() { return Math.sqrt(MU / Math.pow(params.semiMajor, 3)); }

    function solveKepler(M, e) {
      let E = e < 0.8 ? M : Math.PI;
      for (let i = 0; i < 14; i++) {
        const f = E - e * Math.sin(E) - M;
        const fp = 1 - e * Math.cos(E);
        E -= f / fp;
      }
      return E;
    }

    function rotateZ(v, angle) {
      const c = Math.cos(angle), s = Math.sin(angle);
      return new THREE.Vector3(c * v.x - s * v.z, v.y, s * v.x + c * v.z);
    }

    function rotateX(v, angle) {
      const c = Math.cos(angle), s = Math.sin(angle);
      return new THREE.Vector3(v.x, c * v.y - s * v.z, s * v.y + c * v.z);
    }

    function satelliteStateKeplerAt(t) {
      const a = params.semiMajor;
      const e = params.eccentricity;
      const n = meanMotion();
      const M0 = params.meanAnomaly * DEG;
      const M = normalizeAngle(M0 + n * t);
      const E = solveKepler(M, e);
      const xOrb = a * (Math.cos(E) - e);
      const yOrb = a * Math.sqrt(1 - e * e) * Math.sin(E);
      let r = new THREE.Vector3(xOrb, 0, yOrb);
      r = rotateZ(r, params.argPerigee * DEG);
      r = rotateX(r, params.inclination * DEG);
      r = rotateZ(r, params.raan * DEG);
      const rMag = r.length();
      const speed = Math.sqrt(MU * (2 / rMag - 1 / a));
      return { positionKm: r, radiusKm: rMag, speed, M, E };
    }

    function satelliteStateAt(t) {
      return satelliteStateKeplerAt(t);
    }

    function normalizeAngle(angle) { return ((angle % TWO_PI) + TWO_PI) % TWO_PI; }
    function earthRotationAngle(t) { return normalizeAngle(EARTH_ROT_RATE * t); }

    function observerState(t) {
      const lat = params.observerLat * DEG;
      const lonInertial = params.observerLon * DEG + earthRotationAngle(t);
      const positionKm = geoToVector(lat, lonInertial, EARTH_RADIUS_KM);
      const up = positionKm.clone().normalize();
      const east = new THREE.Vector3(-Math.sin(lonInertial), 0, Math.cos(lonInertial)).normalize();
      const north = new THREE.Vector3(-Math.sin(lat) * Math.cos(lonInertial), Math.cos(lat), -Math.sin(lat) * Math.sin(lonInertial)).normalize();
      const omegaCrossR = new THREE.Vector3(EARTH_ROT_RATE * positionKm.z, 0, -EARTH_ROT_RATE * positionKm.x);
      return { positionKm, velocityKmS: omegaCrossR, up, east, north, lat, lonInertial };
    }

    function topocentric(satKm, obs) {
      const rho = satKm.clone().sub(obs.positionKm);
      const range = rho.length();
      const east = rho.dot(obs.east);
      const north = rho.dot(obs.north);
      const up = rho.dot(obs.up);
      const elevation = Math.asin(up / range);
      const azimuth = normalizeAngle(Math.atan2(east, north));
      return { range, elevation, azimuth, east, north, up, rho };
    }

    function signalStrength(elevation, rangeKm) {
      const visibility = Math.max(0, Math.sin(elevation));
      const scaledRange = rangeKm / 1000;
      return params.signalGain * visibility / (scaledRange * scaledRange);
    }

    function rangeRateAt(t, topoNow) {
      const step = 0.5;
      const topo2 = topocentric(satelliteStateAt(t + step).positionKm, observerState(t + step));
      return (topo2.range - topoNow.range) / step;
    }

    function observedFrequencyMHz(rangeRateKmS) { return params.carrierFreq * (1 - rangeRateKmS / C_KM_S); }

    function rebuildOrbitVisuals() {
      const signature = `${params.semiMajor}|${params.eccentricity}|${params.inclination}|${params.raan}|${params.argPerigee}|${params.meanAnomaly}`;
      if (signature === orbitSignature) return;
      orbitSignature = signature;

      const pts = [];
      const groundPts = [];
      const samples = 520;
      const period = orbitalPeriod();
      for (let j = 0; j <= samples; j++) {
        const t = period * j / samples;
        const state = satelliteStateKeplerAt(t);
        pts.push(state.positionKm.clone().multiplyScalar(KM_TO_SCENE));
        groundPts.push(state.positionKm.clone().normalize().multiplyScalar((EARTH_RADIUS_KM + 18) * KM_TO_SCENE));
      }
      orbitLine.geometry.dispose();
      orbitLine.geometry = new THREE.BufferGeometry().setFromPoints(pts);
      groundTrackLine.geometry.dispose();
      groundTrackLine.geometry = new THREE.BufferGeometry().setFromPoints(groundPts);
    }

    function updateScene(dt) {
      const period = orbitalPeriod();
      if (running) {
        simTime += dt * params.timeScale;
        params.manualTime = simTime;
        ui.manualTime.input.max = Math.ceil(Math.max(period, simTime + period * 0.15));
        ui.manualTime.input.value = params.manualTime;
        updateLabels(ui);
      } else {
        simTime = params.manualTime;
        ui.manualTime.input.max = Math.ceil(Math.max(period, simTime + period * 0.15));
      }

      const sat = satelliteStateAt(simTime);
      const obs = observerState(simTime);
      const topo = topocentric(sat.positionKm, obs);
      const signal = signalStrength(topo.elevation, topo.range);
      const signalRate = estimateSignalRate(simTime, signal);
      const rr = rangeRateAt(simTime, topo);
      const fObserved = observedFrequencyMHz(rr);
      const dopplerHz = (fObserved - params.carrierFreq) * 1e6;

      if (running && simTime >= lastSignalTime) {
        const delta = simTime - lastSignalTime;
        if (delta > 0 && delta < 20) signalIntegral += (lastSignal + signal) * 0.5 * delta;
        lastSignal = signal;
        lastSignalTime = simTime;
      }

      recordAnalysisSample(simTime, sat, topo, signal, signalRate, rr, dopplerHz, fObserved);

      const theta = earthRotationAngle(simTime);
      earthGroup.rotation.y = -theta;

      satellite.position.copy(sat.positionKm).multiplyScalar(KM_TO_SCENE);
      observer.position.copy(obs.positionKm).multiplyScalar(KM_TO_SCENE * 1.012);
      horizonDisk.position.copy(observer.position);
      horizonDisk.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), obs.up.clone().normalize());

      updateLine(lineOfSight, [observer.position, satellite.position]);
      lineOfSight.material.color.set(topo.elevation > 0 ? 0x9cffb0 : 0xff7a7a);
      lineOfSight.material.opacity = topo.elevation > 0 ? 0.9 : 0.25;
      const satelliteScale = THREE.MathUtils.clamp(camera.position.distanceTo(satellite.position) / 10, 1, 2.8);
      satellite.scale.setScalar(satelliteScale);

      updateStatus(sat, topo, signal, signalRate, period, theta, rr, dopplerHz, fObserved);
      updateObserverView(topo, signal);
      pushGraphSample(simTime, signal, period);
      updateSpectrum(signal, fObserved, dopplerHz);
      drawGraph(period);
    }

    function estimateSignalRate(t, currentSignal) {
      const step = 1;
      const topo2 = topocentric(satelliteStateAt(t + step).positionKm, observerState(t + step));
      return (signalStrength(topo2.elevation, topo2.range) - currentSignal) / step;
    }

    function updateLine(line, points) {
      line.geometry.dispose();
      line.geometry = new THREE.BufferGeometry().setFromPoints(points);
    }

    function updateObserverView(topo, signal) {
      const radius = 2.1;
      const visible = topo.elevation >= 0;
      const satPos = observerSkyPosition(topo.elevation, topo.azimuth, radius);

      observerSatellite.position.copy(satPos);
      observerSatellite.scale.setScalar(THREE.MathUtils.clamp(0.9 + signal * 0.7, 0.9, 2.3));
      observerSatellite.material.color.set(visible ? 0xffffff : 0xff7a7a);

      updateLine(observerSightLine, [new THREE.Vector3(0, 0.04, 0), satPos]);
      observerSightLine.material.color.set(visible ? 0x75d6ff : 0xff7a7a);
      observerSightLine.material.opacity = visible ? 0.9 : 0.42;

      const showTrail = document.getElementById('observerTrailMode')?.checked;
      observerTrailLine.visible = Boolean(showTrail);
      if (showTrail) updateObserverTrail(radius);
    }

    function observerSkyPosition(elevation, azimuth, radius) {
      const clampedElevation = Math.max(-25 * DEG, elevation);
      const horizontalRadius = radius * Math.cos(clampedElevation);
      const y = radius * Math.sin(clampedElevation);
      const x = horizontalRadius * Math.sin(azimuth);
      const z = -horizontalRadius * Math.cos(azimuth);
      return new THREE.Vector3(x, y, z);
    }

    function updateObserverTrail(radius) {
      const period = orbitalPeriod();
      const samples = 190;
      const start = Math.max(0, simTime - period * 0.22);
      const end = simTime + period * 0.22;
      const pts = [];
      for (let i = 0; i <= samples; i++) {
        const t = start + (end - start) * i / samples;
        const topo = topocentric(satelliteStateAt(t).positionKm, observerState(t));
        if (topo.elevation > -25 * DEG) pts.push(observerSkyPosition(topo.elevation, topo.azimuth, radius));
      }
      observerTrailLine.geometry.dispose();
      observerTrailLine.geometry = new THREE.BufferGeometry().setFromPoints(pts);
    }

    function updateStatus(sat, topo, signal, signalRate, period, theta, rangeRate, dopplerHz, fObserved) {
      const altitude = sat.radiusKm - EARTH_RADIUS_KM;
      document.getElementById('statTime').textContent = `${simTime.toFixed(0)} s`;
      document.getElementById('statEarthRot').textContent = `${(theta / DEG).toFixed(2)}°`;
      document.getElementById('statPeriod').textContent = `${(period / 60).toFixed(1)} min`;
      document.getElementById('statAltitude').textContent = `${altitude.toFixed(0)} km`;
      document.getElementById('statVelocity').textContent = `${sat.speed.toFixed(2)} km/s`;
      document.getElementById('statRange').textContent = `${topo.range.toFixed(0)} km`;
      document.getElementById('statRangeRate').textContent = `${rangeRate >= 0 ? '+' : ''}${rangeRate.toFixed(3)} km/s`;
      document.getElementById('statElevation').textContent = `${(topo.elevation / DEG).toFixed(1)}°`;
      document.getElementById('statAzimuth').textContent = `${(topo.azimuth / DEG).toFixed(1)}°`;
      document.getElementById('statDoppler').textContent = `${dopplerHz >= 0 ? '+' : ''}${dopplerHz.toFixed(0)} Hz`;
      document.getElementById('statObservedFreq').textContent = `${fObserved.toFixed(6)} MHz`;
      document.getElementById('statSignal').textContent = signal.toFixed(4);
      document.getElementById('statSignalRate').textContent = `${signalRate >= 0 ? '+' : ''}${signalRate.toFixed(5)} /s`;
      document.getElementById('statIntegral').textContent = signalIntegral.toFixed(2);
      const visibility = document.getElementById('statVisibility');
      visibility.textContent = topo.elevation > 0 ? '관측 가능' : '지평선 아래';
      visibility.className = topo.elevation > 0 ? 'visible' : 'hidden';
    }

    function pushGraphSample(t, signal, period) {
      if (!running) return;
      if (graphSamples.length === 0 || t - graphSamples[graphSamples.length - 1].t > period / 360) graphSamples.push({ t, signal });
      const windowStart = Math.max(0, t - period);
      graphSamples = graphSamples.filter(p => p.t >= windowStart);
      if (graphSamples.length > 520) graphSamples.shift();
    }

    function updateSpectrum(signal, fObserved, dopplerHz) {
      const bins = cumulativeSpectrum.length;
      const bwMHz = params.bandwidth / 1000;
      const start = params.carrierFreq - bwMHz / 2;
      const sigmaMHz = Math.max(0.002, bwMHz / 90);
      const realTime = new Float32Array(bins);
      for (let i = 0; i < bins; i++) {
        const f = start + bwMHz * i / (bins - 1);
        const x = (f - fObserved) / sigmaMHz;
        const peak = signal * Math.exp(-0.5 * x * x);
        const noise = 0.008 + 0.012 * pseudoNoise(i, simTime);
        realTime[i] = noise + peak;
        cumulativeSpectrum[i] = cumulativeSpectrum[i] * 0.998 + peak * 0.035;
      }
      drawSpectrum(realTime, fObserved, dopplerHz);
    }

    function pseudoNoise(i, t) {
      const x = Math.sin(i * 12.9898 + Math.floor(t * 3) * 78.233) * 43758.5453;
      return x - Math.floor(x);
    }

    function drawSpectrum(realTime, fObserved, dopplerHz) {
      const canvas = document.getElementById('spectrumGraph');
      const ctx = canvas.getContext('2d');
      const w = canvas.width = canvas.clientWidth * Math.min(devicePixelRatio, 2);
      const h = canvas.height = canvas.clientHeight * Math.min(devicePixelRatio, 2);
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = 'rgba(2, 5, 12, 0.2)';
      ctx.fillRect(0, 0, w, h);

      const padL = 64, padR = 24, padT = 26, padB = 52;
      const plotW = w - padL - padR;
      const plotH = h - padT - padB;
      const useCumulative = document.getElementById('spectrumMode').checked;
      const data = useCumulative ? cumulativeSpectrum : realTime;
      const maxVal = Math.max(0.03, ...data);

      ctx.strokeStyle = 'rgba(255,255,255,0.11)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let i = 0; i <= 5; i++) {
        const y = padT + plotH * i / 5;
        ctx.moveTo(padL, y); ctx.lineTo(w - padR, y);
      }
      for (let i = 0; i <= 6; i++) {
        const x = padL + plotW * i / 6;
        ctx.moveTo(x, padT); ctx.lineTo(x, padT + plotH);
      }
      ctx.stroke();

      ctx.beginPath();
      for (let i = 0; i < data.length; i++) {
        const x = padL + plotW * i / (data.length - 1);
        const y = padT + plotH - (data[i] / maxVal) * plotH;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = useCumulative ? '#ffcf70' : '#75d6ff';
      ctx.lineWidth = 2.5;
      ctx.stroke();

      const bwMHz = params.bandwidth / 1000;
      const start = params.carrierFreq - bwMHz / 2;
      const freqX = padL + ((fObserved - start) / bwMHz) * plotW;
      ctx.beginPath();
      ctx.moveTo(freqX, padT);
      ctx.lineTo(freqX, padT + plotH);
      ctx.strokeStyle = '#9cffb0';
      ctx.lineWidth = 2;
      ctx.stroke();

      ctx.fillStyle = 'rgba(232, 238, 252, 0.9)';
      ctx.font = '20px system-ui';
      ctx.fillText(useCumulative ? '누적 세기' : '실시간 세기', 12, 24);
      ctx.font = '18px system-ui';
      ctx.fillStyle = 'rgba(159, 176, 208, 0.95)';
      ctx.fillText(`${start.toFixed(3)} MHz`, padL, h - 18);
      ctx.fillText(`${(start + bwMHz).toFixed(3)} MHz`, w - 160, h - 18);
      ctx.fillText(`도플러 ${dopplerHz >= 0 ? '+' : ''}${dopplerHz.toFixed(0)} Hz`, padL, 52);
    }


    function trapezoidAreaFromSamples(samples) {
      if (!samples || samples.length < 2) return 0;
      let area = 0;
      for (let i = 1; i < samples.length; i++) {
        const dt = samples[i].t - samples[i - 1].t;
        if (dt > 0 && dt < 120) area += (samples[i - 1].signal + samples[i].signal) * 0.5 * dt;
      }
      return area;
    }

    function graphWindowIntegralStats(period) {
      const windowStart = Math.max(0, simTime - period);
      const samples = graphSamples.filter(p => p.t >= windowStart && p.t <= simTime);
      const area = trapezoidAreaFromSamples(samples);
      const duration = samples.length > 1 ? samples[samples.length - 1].t - samples[0].t : 0;
      const maxSignal = Math.max(0.05, ...graphSamples.map(p => p.signal));
      const rectangleArea = Math.max(1e-9, maxSignal * Math.max(1, duration));
      const fillRatio = Math.max(0, Math.min(1, area / rectangleArea));
      const avgSignal = duration > 0 ? area / duration : 0;
      return { area, duration, maxSignal, rectangleArea, fillRatio, avgSignal };
    }

    function drawGraph(period) {
      const canvas = document.getElementById('signalGraph');
      const ctx = canvas.getContext('2d');
      const pr = Math.min(devicePixelRatio, 2);
      const w = canvas.width = canvas.clientWidth * pr;
      const h = canvas.height = canvas.clientHeight * pr;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = 'rgba(2, 5, 12, 0.2)';
      ctx.fillRect(0, 0, w, h);
      const padL = 58, padR = 22, padT = 30, padB = 52;
      const plotW = w - padL - padR;
      const plotH = h - padT - padB;

      const maxSignal = Math.max(0.05, ...graphSamples.map(p => p.signal));
      const windowStart = Math.max(0, simTime - period);
      const windowEnd = windowStart + period;
      const xFor = t => padL + ((t - windowStart) / (windowEnd - windowStart)) * plotW;
      const yFor = s => padT + plotH - (s / maxSignal) * plotH;
      const baseY = padT + plotH;
      const integralStats = graphWindowIntegralStats(period);

      ctx.strokeStyle = 'rgba(255,255,255,0.12)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let i = 0; i <= 5; i++) { const y = padT + plotH * i / 5; ctx.moveTo(padL, y); ctx.lineTo(w - padR, y); }
      for (let i = 0; i <= 6; i++) { const x = padL + plotW * i / 6; ctx.moveTo(x, padT); ctx.lineTo(x, padT + plotH); }
      ctx.stroke();

      if (graphSamples.length > 1) {
        const visibleSamples = graphSamples.filter(p => p.t >= windowStart && p.t <= simTime);

        // 1) 적분 영역: 현재까지 실제로 누적한 부분만 강조해서 채웁니다.
        if (visibleSamples.length > 1) {
          const gradient = ctx.createLinearGradient(0, padT, 0, baseY);
          gradient.addColorStop(0, 'rgba(255, 207, 112, 0.34)');
          gradient.addColorStop(1, 'rgba(117, 214, 255, 0.08)');
          ctx.beginPath();
          visibleSamples.forEach((p, idx) => {
            const x = xFor(p.t), y = yFor(p.signal);
            if (idx === 0) ctx.moveTo(x, baseY), ctx.lineTo(x, y);
            else ctx.lineTo(x, y);
          });
          ctx.lineTo(xFor(visibleSamples[visibleSamples.length - 1].t), baseY);
          ctx.closePath();
          ctx.fillStyle = gradient;
          ctx.fill();

          // 2) 사다리꼴 공식 시각화: 너무 촘촘하지 않게 일부 분할선만 표시합니다.
          const stride = Math.max(1, Math.floor(visibleSamples.length / 38));
          ctx.beginPath();
          for (let i = 0; i < visibleSamples.length; i += stride) {
            const x = xFor(visibleSamples[i].t);
            ctx.moveTo(x, yFor(visibleSamples[i].signal));
            ctx.lineTo(x, baseY);
          }
          ctx.strokeStyle = 'rgba(255, 207, 112, 0.22)';
          ctx.lineWidth = 1;
          ctx.stroke();
        }

        // 3) S(t) 곡선
        ctx.beginPath();
        graphSamples.forEach((p, idx) => {
          const x = xFor(p.t), y = yFor(p.signal);
          if (idx === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        });
        ctx.strokeStyle = '#75d6ff';
        ctx.lineWidth = 3;
        ctx.stroke();
      }

      const currentX = xFor(simTime);
      ctx.beginPath();
      ctx.moveTo(currentX, padT);
      ctx.lineTo(currentX, baseY);
      ctx.strokeStyle = '#ffcf70';
      ctx.lineWidth = 2;
      ctx.stroke();

      // 그래프 안쪽에 적분값이 증가하는 막대를 표시합니다.
      const barW = Math.min(250 * pr, plotW * 0.48);
      const barH = 12 * pr;
      const barX = w - padR - barW;
      const barY = padT + 8 * pr;
      ctx.fillStyle = 'rgba(255,255,255,0.08)';
      ctx.fillRect(barX, barY, barW, barH);
      ctx.fillStyle = 'rgba(255,207,112,0.86)';
      ctx.fillRect(barX, barY, barW * integralStats.fillRatio, barH);
      ctx.strokeStyle = 'rgba(255,255,255,0.18)';
      ctx.strokeRect(barX, barY, barW, barH);

      ctx.fillStyle = 'rgba(232, 238, 252, 0.90)';
      ctx.font = `${20 * pr}px system-ui`;
      ctx.fillText('S(t)', 12 * pr, 28 * pr);
      ctx.fillText('t', w - 28 * pr, h - 12 * pr);

      ctx.font = `${14 * pr}px system-ui`;
      ctx.fillStyle = 'rgba(255, 232, 173, 0.95)';
      ctx.fillText(`색칠된 면적 Qᵍ ≈ ${integralStats.area.toFixed(2)}`, barX, barY + 30 * pr);
      ctx.fillStyle = 'rgba(159, 176, 208, 0.95)';
      ctx.fillText(`평균 S ≈ ${integralStats.avgSignal.toFixed(4)}`, barX, barY + 49 * pr);
      ctx.fillText(`max ${maxSignal.toFixed(3)}`, 12 * pr, 58 * pr);
      ctx.fillText(`최근 ${(period / 60).toFixed(1)} min`, w - 165 * pr, h - 14 * pr);
    }


    function updateKeyboardCamera(dt) {
      if (pressedKeys.size === 0) return;

      const forward = new THREE.Vector3();
      camera.getWorldDirection(forward).normalize();

      const right = new THREE.Vector3();
      right.setFromMatrixColumn(camera.matrixWorld, 0).normalize();

      const move = new THREE.Vector3();
      if (pressedKeys.has('w')) move.add(forward);
      if (pressedKeys.has('s')) move.sub(forward);
      if (pressedKeys.has('d')) move.add(right);
      if (pressedKeys.has('a')) move.sub(right);
      if (move.lengthSq() === 0) return;

      const distance = Math.max(controls.getDistance(), 4);
      const speed = THREE.MathUtils.clamp(distance * 0.85 * params.cameraSpeed, 1, 2600);
      move.normalize().multiplyScalar(speed * dt);

      camera.position.add(move);
      controls.target.add(move);
    }

    function animate(now) {
      const dt = Math.min((now - lastFrame) / 1000, 0.05);
      lastFrame = now;
      updateKeyboardCamera(dt);
      controls.update();
      observerControls.update();
      rebuildOrbitVisuals();
      updateScene(dt);
      updateReplayCameraIfNeeded();
      resizeObserverRendererIfNeeded();
      renderer.render(scene, camera);
      observerRenderer.render(observerScene, observerCamera);
      requestAnimationFrame(animate);
    }

    function resizeObserverRendererIfNeeded() {
      const width = observerCanvas.clientWidth;
      const height = observerCanvas.clientHeight;
      const pr = Math.min(window.devicePixelRatio, 2);
      if (observerCanvas.width !== Math.floor(width * pr) || observerCanvas.height !== Math.floor(height * pr)) {
        observerRenderer.setPixelRatio(pr);
        observerRenderer.setSize(width, height, false);
        observerCamera.aspect = width / height;
        observerCamera.updateProjectionMatrix();
      }
    }

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      resizeObserverRendererIfNeeded();
    });

    requestAnimationFrame(animate);
  </script>
</body>
