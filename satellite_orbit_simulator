    function getSelectedPassData() {
      refreshEventPassSelect();
      const passes = getAllPasses();
      const select = document.getElementById('eventPassSelect');
      const idx = select ? Number(select.value) : passes.length - 1;
      const pass = passes[idx];
      if (!pass) return null;
      const samples = analysisSamples.filter(row => row.visible === 1 && row.time_s >= pass.start_s && row.time_s <= pass.end_s);
      return { pass, samples, index: idx };
    }

    function trapezoidAreaFromRows(rows) {
      if (!rows || rows.length < 2) return 0;
      let area = 0;
      for (let i = 1; i < rows.length; i++) {
        const dt = rows[i].time_s - rows[i - 1].time_s;
        if (dt > 0 && dt < 120) area += (rows[i - 1].signal + rows[i].signal) * 0.5 * dt;
      }
      return area;
    }

    function analyzeSelectedPassData(pass, rows) {
      if (!pass || !rows || rows.length < 2) return null;
      let peakIndex = 0;
      for (let i = 1; i < rows.length; i++) {
        if (rows[i].signal > rows[peakIndex].signal) peakIndex = i;
      }
      const area = trapezoidAreaFromRows(rows);
      const duration = Math.max(0, pass.duration_s);
      const avgSignal = duration > 0 ? area / duration : 0;
      const startSignal = rows[0].signal;
      const endSignal = rows[rows.length - 1].signal;
      const peakRow = rows[peakIndex];
      const riseDuration = Math.max(0, peakRow.time_s - rows[0].time_s);
      const fallDuration = Math.max(0, rows[rows.length - 1].time_s - peakRow.time_s);
      const riseSlope = riseDuration > 0 ? (peakRow.signal - startSignal) / riseDuration : 0;
      const fallSlope = fallDuration > 0 ? (endSignal - peakRow.signal) / fallDuration : 0;
      const symmetryRatio = fallDuration > 0 ? riseDuration / fallDuration : Infinity;
      const maxElevation = Math.max(...rows.map(r => r.elevation_deg));
      const minRange = Math.min(...rows.map(r => r.range_km));
      const signalStd = (() => {
        const mean = rows.reduce((s, r) => s + r.signal, 0) / rows.length;
        const variance = rows.reduce((s, r) => s + (r.signal - mean) ** 2, 0) / rows.length;
        return Math.sqrt(variance);
      })();
      return {
        area,
        duration,
        avgSignal,
        peakRow,
        riseDuration,
        fallDuration,
        riseSlope,
        fallSlope,
        symmetryRatio,
        maxElevation,
        minRange,
        startSignal,
        endSignal,
        signalStd
      };
    }

    function interpretPassAnalysis(pass, rows, stats) {
      if (!pass || !rows || !stats) {
        return '아직 분석할 관측 이벤트가 없습니다. 위성이 지평선 위로 한 번 지나가면, 그 구간의 순간 신호 세기 그래프와 해설이 여기에 표시됩니다.';
      }
      const passType = stats.maxElevation >= 80 ? '거의 머리 위를 지나는 매우 높은 통과' : stats.maxElevation >= 45 ? '비교적 높은 통과' : '낮은 고도각의 통과';
      const symmetryText = stats.symmetryRatio > 1.25 ? '상승 구간이 하강 구간보다 더 길어, 천천히 강해졌다가 비교적 빠르게 약해진 형태입니다.' : stats.symmetryRatio < 0.8 ? '상승 구간보다 하강 구간이 더 길어, 빠르게 강해진 뒤 천천히 약해진 형태입니다.' : '상승 구간과 하강 구간 길이가 비슷하여 비교적 대칭적인 종 모양 그래프에 가깝습니다.';
      const spreadText = stats.signalStd > stats.avgSignal * 0.8 ? '신호의 변동 폭이 커서 특정 시점 부근에 신호가 집중되어 있습니다.' : '신호의 변동 폭이 비교적 완만하여 통과 전반에 걸쳐 고르게 분포합니다.';
      return [
        `이 관측 이벤트는 ${passType}입니다. 총 관측 시간은 약 ${stats.duration.toFixed(1)}초이고, 그래프 아래 면적(적분값)인 누적 수신량은 Q ≈ ${stats.area.toFixed(2)}입니다.`,
        `순간 신호 세기 S(t)는 시작 시 ${stats.startSignal.toFixed(4)}에서 증가하여 t ≈ ${stats.peakRow.time_s.toFixed(1)}초에서 최대 ${stats.peakRow.signal.toFixed(4)}를 기록한 뒤 다시 감소합니다. 따라서 최대점 이전에는 대체로 S′(t) > 0, 최대점 이후에는 S′(t) < 0 로 해석할 수 있습니다.`,
        `최대 고도각은 ${stats.maxElevation.toFixed(1)}°, 최소 거리는 약 ${stats.minRange.toFixed(0)} km이며, 평균 신호 세기는 ${stats.avgSignal.toFixed(4)}입니다. ${symmetryText} ${spreadText}`,
        `즉 이 그래프는 “신호의 높이” 자체보다도 “그래프 아래 면적”이 중요하다는 점을 보여 줍니다. 최대 신호가 다소 높지 않더라도 지속 시간이 길면 Q가 커질 수 있고, 반대로 매우 강한 신호라도 짧게 지나가면 적분값은 크게 늘지 않을 수 있습니다.`
      ].join('\n\n');
    }

    function drawEventGraph(rows, pass, stats) {
      const canvas = document.getElementById('eventSignalGraph');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const pr = Math.min(devicePixelRatio, 2);
      const w = canvas.width = canvas.clientWidth * pr;
      const h = canvas.height = canvas.clientHeight * pr;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = 'rgba(2, 5, 12, 0.2)';
      ctx.fillRect(0, 0, w, h);
      const padL = 58, padR = 24, padT = 26, padB = 46;
      const plotW = w - padL - padR;
      const plotH = h - padT - padB;
      const baseY = padT + plotH;

      if (!rows || rows.length < 2 || !pass || !stats) {
        ctx.fillStyle = 'rgba(232, 238, 252, 0.75)';
        ctx.font = `${16 * pr}px system-ui`;
        ctx.fillText('관측 이벤트가 아직 없습니다.', 18 * pr, 28 * pr);
        return;
      }

      const minT = pass.start_s;
      const maxT = pass.end_s;
      const maxSignal = Math.max(0.05, ...rows.map(r => r.signal));
      const xFor = t => padL + ((t - minT) / Math.max(1e-9, (maxT - minT))) * plotW;
      const yFor = s => padT + plotH - (s / maxSignal) * plotH;

      ctx.strokeStyle = 'rgba(255,255,255,0.12)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let i = 0; i <= 5; i++) { const y = padT + plotH * i / 5; ctx.moveTo(padL, y); ctx.lineTo(w - padR, y); }
      for (let i = 0; i <= 6; i++) { const x = padL + plotW * i / 6; ctx.moveTo(x, padT); ctx.lineTo(x, baseY); }
      ctx.stroke();

      const gradient = ctx.createLinearGradient(0, padT, 0, baseY);
      gradient.addColorStop(0, 'rgba(255, 207, 112, 0.34)');
      gradient.addColorStop(1, 'rgba(117, 214, 255, 0.08)');
      ctx.beginPath();
      rows.forEach((row, idx) => {
        const x = xFor(row.time_s), y = yFor(row.signal);
        if (idx === 0) ctx.moveTo(x, baseY), ctx.lineTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.lineTo(xFor(rows[rows.length - 1].time_s), baseY);
      ctx.closePath();
      ctx.fillStyle = gradient;
      ctx.fill();

      ctx.beginPath();
      rows.forEach((row, idx) => {
        const x = xFor(row.time_s), y = yFor(row.signal);
        if (idx === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.strokeStyle = '#75d6ff';
      ctx.lineWidth = 2.8;
      ctx.stroke();

      const peakX = xFor(stats.peakRow.time_s);
      const peakY = yFor(stats.peakRow.signal);
      ctx.beginPath();
      ctx.moveTo(peakX, padT);
      ctx.lineTo(peakX, baseY);
      ctx.strokeStyle = 'rgba(255, 207, 112, 0.95)';
      ctx.lineWidth = 2;
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(peakX, peakY, 4 * pr, 0, Math.PI * 2);
      ctx.fillStyle = '#ffcf70';
      ctx.fill();

      ctx.fillStyle = 'rgba(232, 238, 252, 0.9)';
      ctx.font = `${17 * pr}px system-ui`;
      ctx.fillText('선택한 관측 이벤트의 S(t)', 14 * pr, 22 * pr);
      ctx.font = `${13 * pr}px system-ui`;
      ctx.fillStyle = 'rgba(255, 232, 173, 0.95)';
      ctx.fillText(`Q ≈ ${stats.area.toFixed(2)}`, 14 * pr, 44 * pr);
      ctx.fillText(`최대 S ≈ ${stats.peakRow.signal.toFixed(4)}`, 14 * pr, 63 * pr);
      ctx.fillStyle = 'rgba(159, 176, 208, 0.95)';
      ctx.fillText(`${minT.toFixed(0)} s`, padL, h - 14 * pr);
      ctx.fillText(`${maxT.toFixed(0)} s`, w - 72 * pr, h - 14 * pr);
      ctx.fillText(`피크 시각 ${stats.peakRow.time_s.toFixed(1)} s`, Math.max(14 * pr, peakX - 40 * pr), Math.max(18 * pr, peakY - 12 * pr));
    }

    function updateEventAnalysisUI(forceSelectLatest = false) {
