      lines.push(`최대 순간 신호가 가장 큰 조건은 a=${bestPeak.semi_major_km.toFixed(0)} km, i=${bestPeak.inclination_deg.toFixed(1)}°이며, 가장 오래 보인 조건은 a=${bestDuration.semi_major_km.toFixed(0)} km, i=${bestDuration.inclination_deg.toFixed(1)}°입니다.`);
