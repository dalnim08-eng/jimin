    function startSimulationFromAutoResult(index) {
      const result = autoExperimentResults[index];
      if (!result) return;
      const replayStart = Math.max(0, Number(result.replay_start_s || result.pass_start_s || 0));
      const replayEnd = Math.max(replayStart + 120, Number(result.replay_end_s || result.pass_end_s || replayStart + 600));

      applyParamsToUi({
        ...result.params_snapshot,
        manualTime: replayStart,
        timeScale: Math.min(Math.max(params.timeScale, 45), 180)
      });

      simTime = replayStart;
      params.manualTime = replayStart;
      running = true;
      document.getElementById('playPause').textContent = '일시정지';
      resetIntegration(true);
      closeAnalysisView();

      replayMode = {
        end_s: replayEnd,
        label: `${result.condition} · ${result.meaning}`,
        started_at_s: replayStart
      };

      const badge = document.getElementById('replayBadge');
      if (badge) {
        badge.textContent = `자동 탐색 결과 재생 중: ${replayMode.label}`;
        badge.classList.add('visible');
      }

      updateScene(0);
      focusCameraOnPass();
    }

    function focusCameraOnPass() {
      const sat = satelliteStateAt(simTime);
      const obs = observerState(simTime);
      const satScene = sat.positionKm.clone().multiplyScalar(KM_TO_SCENE);
      const obsScene = obs.positionKm.clone().multiplyScalar(KM_TO_SCENE * 1.012);
      const midpoint = obsScene.clone().lerp(satScene, 0.42);
      const up = obs.up.clone().normalize();
      const side = obs.east.clone().normalize();
      const rangeScene = Math.max(2.8, satScene.distanceTo(obsScene));
      controls.target.copy(midpoint);
      camera.position.copy(midpoint)
        .add(up.multiplyScalar(rangeScene * 1.25 + 3.6))
        .add(side.multiplyScalar(rangeScene * 1.1 + 2.4));
      camera.lookAt(midpoint);
      controls.update();
    }

    function updateReplayCameraIfNeeded() {
      if (!replayMode) return;
      if (simTime > replayMode.end_s) {
        replayMode = null;
        const badge = document.getElementById('replayBadge');
        if (badge) badge.classList.remove('visible');
        return;
      }
      focusCameraOnPass();
    }

