    function setupPanelControls() {
      const panels = Array.from(document.querySelectorAll('.panel:not(.panel-dock)'));
      const dockButtons = Array.from(document.querySelectorAll('.dock-btn[data-target]'));
      let activePanel = null;
      let startX = 0, startY = 0, startLeft = 0, startTop = 0;

      panels.forEach(panel => {
        const handle = panel.querySelector('.drag-handle') || panel;
        handle.addEventListener('pointerdown', event => {
          if (event.target.closest('button, input, label, canvas')) return;
          activePanel = panel;
          const rect = panel.getBoundingClientRect();
          startX = event.clientX;
          startY = event.clientY;
          startLeft = rect.left;
          startTop = rect.top;
          panel.style.left = `${rect.left}px`;
          panel.style.top = `${rect.top}px`;
          panel.style.right = 'auto';
          panel.style.bottom = 'auto';
          panel.style.width = `${rect.width}px`;
          panel.style.height = `${rect.height}px`;
          panel.classList.add('dragging');
          panel.setPointerCapture(event.pointerId);
        });

        panel.addEventListener('pointermove', event => {
          if (!activePanel || activePanel !== panel) return;
          const dx = event.clientX - startX;
          const dy = event.clientY - startY;
          const rect = panel.getBoundingClientRect();
          const margin = 8;
          const nextLeft = Math.max(margin, Math.min(window.innerWidth - rect.width - margin, startLeft + dx));
          const nextTop = Math.max(margin, Math.min(window.innerHeight - 48, startTop + dy));
          panel.style.left = `${nextLeft}px`;
          panel.style.top = `${nextTop}px`;
        });

        panel.addEventListener('pointerup', event => {
          if (!activePanel || activePanel !== panel) return;
          panel.classList.remove('dragging');
          try { panel.releasePointerCapture(event.pointerId); } catch (_) {}
          activePanel = null;
        });

        new ResizeObserver(() => resizeObserverRendererIfNeeded()).observe(panel);
      });

      document.querySelectorAll('[data-close]').forEach(button => {
        button.addEventListener('click', event => {
          event.stopPropagation();
          const panel = document.getElementById(button.dataset.close);
          if (!panel) return;
          panel.classList.add('collapsed');
          updateDockState();
        });
      });

      dockButtons.forEach(button => {
        button.addEventListener('click', () => {
          const panel = document.getElementById(button.dataset.target);
          if (!panel) return;
          panel.classList.toggle('collapsed');
          if (!panel.classList.contains('collapsed')) bringPanelToFront(panel);
          updateDockState();
        });
      });

      panels.forEach(panel => panel.addEventListener('pointerdown', () => bringPanelToFront(panel)));

      function bringPanelToFront(panel) {
        panels.forEach(p => p.style.zIndex = '10');
        panel.style.zIndex = '25';
      }

      function updateDockState() {
        dockButtons.forEach(button => {
          const panel = document.getElementById(button.dataset.target);
          button.classList.toggle('hidden-panel', panel?.classList.contains('collapsed'));
        });
      }

      updateDockState();
    }

